Options -Indexes
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

# Protection des fichiers techniques du depot
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule (^|/)\.git(?:hub)?(?:/|$) - [F,L,NC]
    RewriteRule (^|/)\.gitattributes$ - [F,L,NC]

    # Laisser accessibles les validations de certificat Let's Encrypt.
    RewriteRule ^\.well-known/acme-challenge/ - [L]

    # Rediriger uniquement une demande explicite d'index.html, pas DirectoryIndex.
    RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
    RewriteRule ^index\.html$ https://alexandrenagaphoto.fr/ [R=301,L]

    # Adresse principale : HTTPS sans www, en conservant le chemin.
    RewriteCond %{HTTP_HOST} ^www\.alexandrenagaphoto\.fr$ [NC]
    RewriteRule ^ https://alexandrenagaphoto.fr%{REQUEST_URI} [R=301,L]

    # Prendre en compte une eventuelle terminaison TLS chez OVH.
    RewriteCond %{HTTPS} !=on
    RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
    RewriteRule ^ https://alexandrenagaphoto.fr%{REQUEST_URI} [R=301,L]
</IfModule>

# Cache navigateur - Alexandre Naga Photo
# Pages et code : verifier les mises a jour a chaque utilisation.
# Photos : cache de 24 heures. Renommer une image pour la remplacer immediatement.
# Polices : cache de 30 jours. Renommer une police si son contenu change.
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' 'sha256-DSCFyOVsuTFTKKQjHcCxvEimwLG6+D1zqKlgnWMiqLQ=' 'sha256-8eLtPX3iP28HwUyJ3vJDCzsV+RYsYOrdKAT1/lgL3dc=' 'sha256-t421/wtS33LcrQhfUG12jg9RPHZZkjjECvQ76evttns=' 'sha256-gBLtLC4FGXApaERgNadG1zQmlxNgOcNP0lhWghXljAU=' 'sha256-g7bQmIQK5CElHUi8lE65IBRLMfRmFxchp9zOtb1KKl4=' 'sha256-d/C2rxjKJg6PTUcVEHWxJHKtyh1JpguQghYPxx5HpZU=' 'sha256-Lh6pZVzPER5sBjG+vcim7jrAKwhUd5tHXct6lJZYf3M=' 'sha256-9VnjDRraDrMIi//GdHgk22OfDw1Ut9n2JyQQMz8520c=' 'sha256-DjFeSpFRWhCxejlYXb1DzRLNNVYsyhGK7ZwqhG8t5Rk='; script-src-attr 'none'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; upgrade-insecure-requests"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Courte durée initiale ; pas d'includeSubDomains ni de preload.
    Header always set Strict-Transport-Security "max-age=86400" "expr=%{HTTPS} == 'on' || req('X-Forwarded-Proto') == 'https'"
    <Files "formulaire-retractation.txt">
        Header set Content-Type "text/plain; charset=UTF-8"
    </Files>

    <FilesMatch "\.(html?|css|js)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
    <FilesMatch "\.(webp|jpe?g|png|gif|avif|svg|ico)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    <FilesMatch "\.(woff2?|ttf|otf)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
